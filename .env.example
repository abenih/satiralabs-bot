# SatiraLabs inquiry bot — configuration template.
# Copy to ".env" and fill in the values (see SETUP.md). Never commit a
# real token, and never paste one into chat logs or tickets.

# Token issued by @BotFather when you create the bot.
BOT_TOKEN=

# Your own numeric Telegram chat id. Inquiries are forwarded to this chat,
# and only this chat can use the /inquiries command. How to find your id
# is explained in SETUP.md. Leave empty to store inquiries locally only.
OWNER_CHAT_ID=

# Optional: where the SQLite data file lives (default: ./data next to bot.py).
# BOT_DATA_DIR=/opt/satiralabs-bot/data
